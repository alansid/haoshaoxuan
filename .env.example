# 複製成 .env.local（本機）或填到 Netlify 的 Environment variables（正式環境）。真正的值不要進 git。

# Supabase：資料庫與登入。兩個都沒填時，網站會進入「本機開發模式」（資料存 .data/，登入不驗證），不可用於正式環境。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API 金鑰。沒填時 AI 營養師會回測試用的假回覆。
ANTHROPIC_API_KEY=
# 選填：使用的模型，預設 claude-opus-5-5
ANTHROPIC_MODEL=

# 選填：每人每日 AI 對話上限；不填或 0 代表不限
CHAT_DAILY_LIMIT=
