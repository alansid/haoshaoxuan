# 複製成 .env.local（本機）或填到 Netlify 的 Environment variables（正式環境）。真正的值不要進 git、不要貼到群組。

# Claude API 金鑰（AI 營養師伊緹）。沒填時回測試用的假回覆。
ANTHROPIC_API_KEY=
# 選填：使用的模型，預設 claude-opus-5-5
ANTHROPIC_MODEL=
# 選填：每人每日 AI 對話上限；不填或 0 代表不限
CHAT_DAILY_LIMIT=

# Supabase：資料庫與 Google 登入。URL 與 ANON_KEY 都沒填時進入「測試模式」（不需資料庫、任何 email 可登入），不可用於正式環境。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 只給每週推播排程使用（跨使用者讀取訂閱），只能放在伺服器端
SUPABASE_SERVICE_ROLE_KEY=
# 選填：網站正式網址，Google 登入完成後導回用，例如 https://example.netlify.app
SITE_URL=

# 每週回顧推播（Web Push）。產生方式：npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 聯絡用，例如 mailto:you@example.com
VAPID_SUBJECT=
# 排程呼叫推播 API 的密碼，隨機長字串即可（例如 openssl rand -hex 32）
CRON_SECRET=
